<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>晨翼Agent控制面板</title>
  <link rel="stylesheet" href="styles/output.css">
</head>
<body class="bg-gray-100 dark:bg-gray-900 min-h-screen">
  
  <!-- 标题栏 - macOS风格 -->
  <div class="glass bg-white/80 dark:bg-gray-800/80 h-12 flex items-center justify-between px-4 border-b border-gray-200/50 dark:border-gray-700/50 fixed top-0 left-0 right-0 z-50">
    <!-- 左侧：红黄绿按钮 -->
    <div class="flex items-center gap-2">
      <div class="flex items-center gap-2 mr-4">
        <button id="btn-close" class="w-3 h-3 rounded-full bg-apple-red hover:brightness-90 active:brightness-75 transition-all"></button>
        <button id="btn-minimize" class="w-3 h-3 rounded-full bg-apple-yellow hover:brightness-90 active:brightness-75 transition-all"></button>
        <button id="btn-maximize" class="w-3 h-3 rounded-full bg-apple-green hover:brightness-90 active:brightness-75 transition-all"></button>
      </div>
      <span class="text-lg">🦐</span>
      <span class="text-sm font-medium text-gray-700 dark:text-gray-200">晨翼 Agent 控制面板</span>
    </div>
    <!-- 右侧：深色模式切换 -->
    <button id="theme-toggle" class="p-2 rounded-lg hover:bg-gray-200/50 dark:hover:bg-gray-700/50 transition-colors">
      <svg class="w-5 h-5 text-gray-600 dark:text-gray-300 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
      </svg>
      <svg class="w-5 h-5 text-gray-300 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
      </svg>
    </button>
  </div>

  <!-- 主容器 -->
  <div class="flex pt-12">
    
    <!-- 侧边导航 -->
    <nav class="glass bg-white/70 dark:bg-gray-800/70 w-56 min-h-screen p-4 border-r border-gray-200/50 dark:border-gray-700/50 fixed left-0 top-12 bottom-0">
      <div class="space-y-2">
        <div class="nav-item active flex items-center gap-3 px-4 py-3 rounded-xl bg-blue-500/10 dark:bg-blue-500/20 text-blue-600 dark:text-blue-400 cursor-pointer transition-all hover:bg-blue-500/20 dark:hover:bg-blue-500/30 hover:scale-[1.02]" data-page="dashboard">
          <span class="text-xl p-2 bg-white dark:bg-gray-700 rounded-lg shadow-sm">📊</span>
          <span class="font-medium">仪表盘</span>
        </div>
        <div class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 dark:text-gray-400 cursor-pointer transition-all hover:bg-gray-200/50 dark:hover:bg-gray-700/50 hover:scale-[1.02]" data-page="phone">
          <span class="text-xl p-2 bg-white dark:bg-gray-700 rounded-lg shadow-sm">📱</span>
          <span class="font-medium">手机连接</span>
        </div>
        <div class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 dark:text-gray-400 cursor-pointer transition-all hover:bg-gray-200/50 dark:hover:bg-gray-700/50 hover:scale-[1.02]" data-page="hermes">
          <span class="text-xl p-2 bg-white dark:bg-gray-700 rounded-lg shadow-sm">🦐</span>
          <span class="font-medium">晨翼助手</span>
        </div>
        <div class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 dark:text-gray-400 cursor-pointer transition-all hover:bg-gray-200/50 dark:hover:bg-gray-700/50 hover:scale-[1.02]" data-page="openclaw">
          <span class="text-xl p-2 bg-white dark:bg-gray-700 rounded-lg shadow-sm">🦞</span>
          <span class="font-medium">OpenClaw</span>
        </div>
        <div class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 dark:text-gray-400 cursor-pointer transition-all hover:bg-gray-200/50 dark:hover:bg-gray-700/50 hover:scale-[1.02]" data-page="tasks">
          <span class="text-xl p-2 bg-white dark:bg-gray-700 rounded-lg shadow-sm">⏰</span>
          <span class="font-medium">任务调度</span>
        </div>
        <div class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 dark:text-gray-400 cursor-pointer transition-all hover:bg-gray-200/50 dark:hover:bg-gray-700/50 hover:scale-[1.02]" data-page="monitor">
          <span class="text-xl p-2 bg-white dark:bg-gray-700 rounded-lg shadow-sm">📈</span>
          <span class="font-medium">系统监控</span>
        </div>
        <div class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 dark:text-gray-400 cursor-pointer transition-all hover:bg-gray-200/50 dark:hover:bg-gray-700/50 hover:scale-[1.02]" data-page="settings">
          <span class="text-xl p-2 bg-white dark:bg-gray-700 rounded-lg shadow-sm">⚙️</span>
          <span class="font-medium">设置</span>
        </div>
        <div class="nav-item flex items-center gap-3 px-4 py-3 rounded-xl text-gray-600 dark:text-gray-400 cursor-pointer transition-all hover:bg-gray-200/50 dark:hover:bg-gray-700/50 hover:scale-[1.02]" data-page="logs">
          <span class="text-xl p-2 bg-white dark:bg-gray-700 rounded-lg shadow-sm">📋</span>
          <span class="font-medium">日志</span>
        </div>
      </div>
    </nav>

    <!-- 主内容区 -->
    <main class="flex-1 ml-56 p-6" id="content">
      <!-- 卡片布局示例 -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- 状态卡片 -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg shadow-gray-200/50 dark:shadow-gray-900/50 border border-gray-100 dark:border-gray-700">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">系统状态</h3>
            <span class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></span>
          </div>
          <p class="text-gray-500 dark:text-gray-400">所有服务运行正常</p>
        </div>

        <!-- 设备卡片 -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg shadow-gray-200/50 dark:shadow-gray-900/50 border border-gray-100 dark:border-gray-700">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">已连接设备</h3>
            <span class="text-2xl">📱</span>
          </div>
          <p class="text-3xl font-bold text-blue-600 dark:text-blue-400">2</p>
        </div>

        <!-- 任务卡片 -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-lg shadow-gray-200/50 dark:shadow-gray-900/50 border border-gray-100 dark:border-gray-700">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">运行中任务</h3>
            <span class="text-2xl">⏰</span>
          </div>
          <p class="text-3xl font-bold text-orange-500 dark:text-orange-400">5</p>
        </div>

      </div>
    </main>

  </div>

  <script>
    // 深色模式切换
    const themeToggle = document.getElementById('theme-toggle');
    const html = document.documentElement;
    
    // 检查本地存储的主题设置
    if (localStorage.getItem('theme') === 'dark') {
      html.classList.add('dark');
    }
    
    themeToggle.addEventListener('click', () => {
      html.classList.toggle('dark');
      localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
    });
  </script>
  <script src="renderer.js"></script>
</body>
</html>
