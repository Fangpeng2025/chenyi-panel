        <div class="flex items-center gap-3 mb-3">
          <span class="text-3xl">📱</span>
          <div>
            <div class="font-semibold text-gray-800 dark:text-gray-100">手机连接</div>
            <div class="text-sm ${phone ? 'text-green-600 dark:text-green-400' : 'text-red-500'}">${phone ? '● 运行中' : '○ 未运行'}</div>
          </div>
        </div>
        <button class="btn ${phone ? 'btn-danger' : 'btn-success'} w-full text-sm" onclick="toggleService('phone_auto_connect')">${phone ? '停止' : '启动'}</button>
      </div>
      <div class="card ${mcp ? 'border-l-4 border-l-green-500' : 'border-l-4 border-l-red-500'}">
        <div class="flex items-center gap-3 mb-3">
          <span class="text-3xl">🔧</span>
          <div>
            <div class="font-semibold text-gray-800 dark:text-gray-100">DroidPilot</div>
            <div class="text-sm ${mcp ? 'text-green-600 dark:text-green-400' : 'text-red-500'}">${mcp ? '● 运行中' : '○ 未运行'}</div>
          </div>
        </div>
        <button class="btn ${mcp ? 'btn-danger' : 'btn-success'} w-full text-sm" onclick="toggleService('droidpilot/mcp-server')">${mcp ? '停止' : '启动'}</button>
      </div>
      <div class="card border-l-4 border-l-blue-500">
        <div class="flex items-center gap-3">
          <span class="text-3xl">📦</span>
          <div>
            <div class="font-semibold text-gray-800 dark:text-gray-100">Skills</div>
            <div class="text-sm text-blue-600 dark:text-blue-400">已加载</div>
          </div>
        </div>
      </div>
    </div>
    <div class="flex gap-3">
      <button class="btn btn-primary" onclick="startAll()">▶ 全部启动</button>
      <button class="btn btn-danger" onclick="stopAll()">⏹ 全部停止</button>
      <button class="btn btn-secondary" onclick="refresh()">🔄 刷新</button>
