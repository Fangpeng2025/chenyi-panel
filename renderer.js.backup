// OpenClaw 服务控制
window.toggleOpenClaw = async (action) => {
  if (action === 'start') {
    await api.exec('nohup openclaw > /dev/null 2>&1 &');
  } else {
    await api.exec('pkill -f "openclaw"');
  }
  setTimeout(() => loadPage('openclaw'), 1500);
