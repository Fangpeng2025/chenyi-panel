// 手机连接页面
async function renderPhone() {
  const phoneProcess = await api.checkProcess('phone_auto_connect');
  const adbDevices = await api.exec('adb devices');
  const connected = adbDevices && adbDevices.includes('\tdevice');
  
  return `
    <h2 class="text-2xl font-bold mb-6 text-gray-800 dark:text-gray-100">📱 手机连接</h2>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="card">
        <h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">连接配置</h3>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">IP 地址</label>
            <input type="text" id="phone-ip" placeholder="192.168.1.100" value="10.194.171.4" 
                   class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-transparent">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">端口</label>
            <input type="text" id="phone-port" placeholder="5555" value="8765" 
                   class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100 focus:ring-2 focus:ring-blue-500 focus:border-transparent">
          </div>
          <div class="flex gap-3">
            <button class="btn btn-primary flex-1" onclick="connectPhone()">🔗 连接</button>
            <button class="btn btn-secondary flex-1" onclick="disconnectPhone()">断开</button>
          </div>
        </div>
      </div>
      
      <div class="card">
        <h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">连接状态</h3>
        <div class="flex items-center gap-4 p-4 rounded-xl ${connected ? 'bg-green-50 dark:bg-green-900/20' : 'bg-red-50 dark:bg-red-900/20'}">
          <span class="text-4xl">${connected ? '✅' : '❌'}</span>
          <div>
            <div class="font-semibold text-gray-800 dark:text-gray-100">${connected ? '已连接' : '未连接'}</div>
            <div class="text-sm ${connected ? 'text-green-600 dark:text-green-400' : 'text-red-500'}">${phoneProcess ? '服务运行中' : '服务未运行'}</div>
          </div>
        </div>
        <div class="mt-4 space-y-2" id="device-info">
          ${connected ? await getDeviceInfo() : '<p class="text-gray-500 dark:text-gray-400">暂无设备信息</p>'}
        </div>
      </div>
      
      <div class="card">
        <h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">屏幕预览</h3>
        <div class="aspect-[9/16] bg-gray-100 dark:bg-gray-700 rounded-xl flex items-center justify-center" id="preview-area">
          <div class="text-center text-gray-400">
            <span class="text-5xl">📱</span>
            <p class="mt-2">点击截图获取预览</p>
          </div>
        </div>
        <div class="flex gap-2 mt-4">
          <button class="btn btn-primary flex-1" onclick="takeScreenshot()">📷 截图</button>
          <button class="btn btn-secondary" onclick="refreshPreview()">🔄</button>
          <button class="btn btn-secondary" onclick="openAdbShell()">💻</button>
        </div>
      </div>
      
      <div class="card">
        <h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">快捷操作</h3>
        <div class="grid grid-cols-3 gap-2">
          <button class="btn btn-secondary" onclick="adbCommand('input keyevent 26')">电源键</button>
          <button class="btn btn-secondary" onclick="adbCommand('input keyevent 3')">Home</button>
          <button class="btn btn-secondary" onclick="adbCommand('input keyevent 4')">返回</button>
          <button class="btn btn-secondary" onclick="adbCommand('input keyevent 82')">菜单</button>
          <button class="btn btn-secondary" onclick="adbCommand('input keyevent 24')">音量+</button>
          <button class="btn btn-secondary" onclick="adbCommand('input keyevent 25')">音量-</button>
        </div>
      </div>
    </div>
  `;
}

// 获取设备信息
async function getDeviceInfo() {
  try {
    const model = await api.exec('adb shell getprop ro.product.model');
    const android = await api.exec('adb shell getprop ro.build.version.release');
    const battery = await api.exec('adb shell dumpsys battery | grep level');
    const level = battery ? battery.match(/level:\s*(\d+)/)?.[1] : '--';
    
    return `
      <div class="info-item"><span>型号:</span> ${model?.trim() || '未知'}</div>
      <div class="info-item"><span>Android:</span> ${android?.trim() || '未知'}</div>
      <div class="info-item"><span>电量:</span> ${level}%</div>
    `;
  } catch (e) {
    return '<p>获取设备信息失败</p>';
  }
}

// 连接手机
window.connectPhone = async () => {
  const ip = document.getElementById('phone-ip').value;
  const port = document.getElementById('phone-port').value;
  
  if (!ip) {
    alert('请输入 IP 地址');
    return;
  }
  
  const btn = event.target;
  btn.disabled = true;
  btn.textContent = '连接中...';
  
  try {
    await api.exec(`adb connect ${ip}:${port}`);
    setTimeout(() => loadPage('phone'), 1500);
  } catch (e) {
    alert('连接失败: ' + e.message);
    btn.disabled = false;
    btn.textContent = '连接';
  }
};

// 断开连接
window.disconnectPhone = async () => {
  const ip = document.getElementById('phone-ip')?.value;
  if (ip) {
    await api.exec(`adb disconnect ${ip}`);
  }
  await api.exec('adb disconnect');
  setTimeout(() => loadPage('phone'), 500);
};

// 截图
window.takeScreenshot = async () => {
  const previewArea = document.getElementById('preview-area');
  previewArea.innerHTML = '<div class="loading">截图中...</div>';
  
  try {
    const timestamp = Date.now();
    const localPath = `/tmp/screenshot_${timestamp}.png`;
    
    await api.exec(`adb shell screencap -p /sdcard/screenshot.png`);
    await api.exec(`adb pull /sdcard/screenshot.png ${localPath}`);
    await api.exec(`adb shell rm /sdcard/screenshot.png`);
    
    previewArea.innerHTML = `
      <img src="file://${localPath}" alt="屏幕截图" class="screenshot-img">
    `;
  } catch (e) {
    previewArea.innerHTML = `<div class="error">截图失败: ${e.message}</div>`;
  }
};

// 刷新预览
window.refreshPreview = async () => {
  await takeScreenshot();
};

// 打开ADB Shell
window.openAdbShell = async () => {
  try {
    await api.exec('gnome-terminal -- bash -c "adb shell"');
  } catch (e) {
    alert('打开终端失败: ' + e.message);
  }
};

// 执行ADB命令
window.adbCommand = async (cmd) => {
  try {
    await api.exec(`adb ${cmd}`);
  } catch (e) {
    console.error('ADB命令执行失败:', e);
  }
};

async function renderHermes() {
  const running = await api.checkProcess('hermes gateway');
  const configPath = require('os').homedir() + '/.hermes/config.yaml';
  const logPath = require('os').homedir() + '/.hermes/logs/agent.log';
  
  // 读取配置
  let config = {};
  try {
    const fs = require('fs');
    if (fs.existsSync(configPath)) {
      const yaml = require('js-yaml');
      config = yaml.load(fs.readFileSync(configPath, 'utf8'));
    }
  } catch (e) {
    console.error('读取配置失败:', e);
  }
  
  return `
    <h2 class="text-2xl font-bold mb-6 text-gray-800 dark:text-gray-100">🦐 晨翼助手</h2>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="card">
        <h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">服务状态</h3>
        <div class="flex items-center gap-4 p-4 rounded-xl ${running ? 'bg-green-50 dark:bg-green-900/20' : 'bg-red-50 dark:bg-red-900/20'}">
          <span class="text-4xl">${running ? '✅' : '❌'}</span>
          <div>
            <div class="font-semibold text-gray-800 dark:text-gray-100">${running ? '运行中' : '未运行'}</div>
            <div class="text-sm ${running ? 'text-green-600 dark:text-green-400' : 'text-red-500'}">Hermes Gateway ${running ? '已启动' : '已停止'}</div>
          </div>
        </div>
        <div class="flex gap-3 mt-4">
          <button class="btn ${running ? 'btn-secondary' : 'btn-success'} flex-1" onclick="toggleHermes('start')" ${running ? 'disabled' : ''}>▶️ 启动</button>
          <button class="btn ${running ? 'btn-danger' : 'btn-secondary'} flex-1" onclick="toggleHermes('stop')" ${!running ? 'disabled' : ''}>⏹️ 停止</button>
          <button class="btn btn-secondary" onclick="refreshHermes()">🔄</button>
        </div>
      </div>
      
      <div class="card">
        <h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">配置信息</h3>
        <div class="space-y-3">
          <div class="flex justify-between items-center p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
            <span class="text-gray-600 dark:text-gray-400">模型</span>
            <span class="font-mono font-semibold text-gray-800 dark:text-gray-100">${config.model || '未配置'}</span>
          </div>
          <div class="flex justify-between items-center p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
            <span class="text-gray-600 dark:text-gray-400">皮肤</span>
            <span class="font-mono text-sm text-blue-600 dark:text-blue-400">${config.display?.skin || 'default'}</span>
          </div>
          <div class="flex justify-between items-center p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
            <span class="text-gray-600 dark:text-gray-400">配置文件</span>
            <span class="font-mono text-xs text-gray-500">~/.hermes/config.yaml</span>
          </div>
        </div>
        <button class="btn btn-primary w-full mt-4" onclick="editHermesConfig()">📝 编辑配置</button>
      </div>
      
      <div class="card lg:col-span-2">
        <h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">快速操作</h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          <button class="btn btn-secondary" onclick="openHermesCLI()">💻 打开终端</button>
          <button class="btn btn-secondary" onclick="viewHermesLogs()">📋 查看日志</button>
          <button class="btn btn-secondary" onclick="listHermesSkills()">🎯 技能列表</button>
          <button class="btn btn-secondary" onclick="listHermesSessions()">💬 会话历史</button>
        </div>
      </div>
    </div>
  `;
}

// Hermes 服务控制
window.toggleHermes = async (action) => {
  if (action === 'start') {
    await api.exec('nohup hermes gateway > /dev/null 2>&1 &');
  } else {
    await api.exec('pkill -f "hermes gateway"');
  }
  setTimeout(() => loadPage('hermes'), 1500);
};

window.refreshHermes = () => loadPage('hermes');
window.editHermesConfig = () => alert('请在终端运行: hermes config edit');
window.openHermesCLI = () => alert('请在终端运行: hermes');
window.viewHermesLogs = async () => {
  const log = await api.exec('tail -n 50 ~/.hermes/logs/agent.log');
  alert(log || '暂无日志');
};
window.listHermesSkills = async () => {
  const skills = await api.exec('hermes skill list');
  alert(skills || '暂无技能');
};
window.listHermesSessions = async () => {
  const sessions = await api.exec('hermes session list');
  alert(sessions || '暂无会话');
};

