};

async function renderTasks() {
  const cronJobs = await api.execSync('crontab -l 2>/dev/null || echo ""');
  const jobs = cronJobs.success ? cronJobs.data.split('\n').filter(l => l.trim() && !l.startsWith('#')) : [];
  
  return `
    <h2 class="text-2xl font-bold mb-6 text-gray-800 dark:text-gray-100">⏰ 任务调度</h2>
    <div class="card mb-6">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">Cron 任务列表</h3>
        <button class="btn btn-primary btn-sm" onclick="refreshTasks()">🔄 刷新</button>
      </div>
      ${jobs.length > 0 ? `
        <div class="space-y-2">
          ${jobs.map((job, i) => `
            <div class="p-3 bg-gray-50 dark:bg-gray-700 rounded-lg font-mono text-sm text-gray-700 dark:text-gray-300">
              ${job}
            </div>
          `).join('')}
        </div>
      ` : `
        <p class="text-gray-500 dark:text-gray-400 text-center py-8">暂无定时任务</p>
      `}
    </div>
    <div class="card">
      <h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">快速添加</h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <button class="btn btn-secondary" onclick="addCronExample('hourly')">每小时执行</button>
        <button class="btn btn-secondary" onclick="addCronExample('daily')">每天执行</button>
        <button class="btn btn-secondary" onclick="addCronExample('weekly')">每周执行</button>
        <button class="btn btn-secondary" onclick="addCronExample('monthly')">每月执行</button>
      </div>
    </div>
  `;
}

window.refreshTasks = () => loadPage('tasks');
window.addCronExample = (type) => alert('请在终端使用 crontab -e 编辑定时任务');

async function renderMonitor() {
  const cpuInfo = await api.execSync('cat /proc/loadavg');
  const memInfo = await api.execSync('cat /proc/meminfo | head -5');
  const diskInfo = await api.execSync('df -h / | tail -1');
  
  const loads = cpuInfo.success ? cpuInfo.data.split(' ').slice(0, 3) : ['?', '?', '?'];
  
  let memTotal = '?', memUsed = '?', memPercent = 0;
  if (memInfo.success) {
    const lines = memInfo.data.split('\n');
    const total = lines.find(l => l.includes('MemTotal'));
    const avail = lines.find(l => l.includes('MemAvailable'));
    if (total && avail) {
      memTotal = Math.round(parseInt(total.split(':')[1].trim()) / 1024 / 1024);
      const availMB = parseInt(avail.split(':')[1].trim()) / 1024 / 1024;
      memUsed = Math.round(memTotal - availMB);
      memPercent = Math.round((memUsed / memTotal) * 100);
    }
  }
  
  let diskTotal = '?', diskUsed = '?', diskPercent = 0;
  if (diskInfo.success) {
    const parts = diskInfo.data.split(/\s+/);
    if (parts.length >= 5) {
      diskTotal = parts[1];
      diskUsed = parts[2];
      diskPercent = parseInt(parts[4]);
    }
  }
  
  return `
    <h2 class="text-2xl font-bold mb-6 text-gray-800 dark:text-gray-100">📈 系统监控</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
      <div class="card">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-3xl">💻</span>
          <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">CPU</h3>
        </div>
        <div class="text-sm text-gray-600 dark:text-gray-400 mb-2">负载: ${loads.join(' / ')}</div>
        <div class="h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
          <div class="h-full bg-blue-500 rounded-full transition-all" style="width: ${Math.min(loads[0] * 20, 100)}%"></div>
        </div>
      </div>
      <div class="card">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-3xl">🧠</span>
          <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">内存</h3>
        </div>
        <div class="text-sm text-gray-600 dark:text-gray-400 mb-2">${memUsed} / ${memTotal} GB (${memPercent}%)</div>
        <div class="h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
          <div class="h-full ${memPercent > 80 ? 'bg-red-500' : 'bg-green-500'} rounded-full transition-all" style="width: ${memPercent}%"></div>
        </div>
      </div>
      <div class="card">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-3xl">💾</span>
          <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">磁盘</h3>
        </div>
        <div class="text-sm text-gray-600 dark:text-gray-400 mb-2">${diskUsed} / ${diskTotal} (${diskPercent}%)</div>
        <div class="h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
          <div class="h-full ${diskPercent > 80 ? 'bg-red-500' : 'bg-green-500'} rounded-full transition-all" style="width: ${diskPercent}%"></div>
        </div>
      </div>
    </div>
    <button class="btn btn-secondary" onclick="loadPage('monitor')">🔄 刷新</button>
  `;
}

async function renderSettings() {
  const theme = localStorage.getItem('theme') || 'auto';
  return `
    <h2 class="text-2xl font-bold mb-6 text-gray-800 dark:text-gray-100">⚙️ 设置</h2>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="card">
        <h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">外观</h3>
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">主题模式</label>
            <select id="theme-select" onchange="changeTheme(this.value)" 
                    class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-gray-100">
              <option value="auto" ${theme === 'auto' ? 'selected' : ''}>跟随系统</option>
              <option value="light" ${theme === 'light' ? 'selected' : ''}>浅色模式</option>
              <option value="dark" ${theme === 'dark' ? 'selected' : ''}>深色模式</option>
            </select>
          </div>
        </div>
      </div>
      <div class="card">
        <h3 class="text-lg font-semibold mb-4 text-gray-800 dark:text-gray-100">关于</h3>
        <div class="space-y-2 text-sm text-gray-600 dark:text-gray-400">
          <p><span class="font-medium text-gray-800 dark:text-gray-100">晨翼面板</span> v1.0.0</p>
          <p>Electron + Tailwind CSS</p>
          <p>© 2026 晨翼Agent</p>
        </div>
      </div>
    </div>
  `;
}

window.changeTheme = (value) => {
  if (value === 'dark') {
    document.documentElement.classList.add('dark');
    localStorage.setItem('theme', 'dark');
  } else if (value === 'light') {
    document.documentElement.classList.remove('dark');
    localStorage.setItem('theme', 'light');
  } else {
    localStorage.removeItem('theme');
    location.reload();
  }
};

async function renderLogs() {
  const logPath = '/home/fangpeng/.hermes/logs/agent.log';
  const result = await api.execSync(`tail -100 ${logPath} 2>/dev/null || echo "日志文件不存在"`);
  const logs = result.success ? result.data : '无法读取日志';
  
  return `
    <h2 class="text-2xl font-bold mb-6 text-gray-800 dark:text-gray-100">📋 日志</h2>
    <div class="card">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-gray-100">最近日志</h3>
        <button class="btn btn-secondary btn-sm" onclick="loadPage('logs')">🔄 刷新</button>
      </div>
      <pre class="bg-gray-900 text-gray-100 p-4 rounded-lg text-xs overflow-x-auto max-h-96 overflow-y-auto font-mono">${logs.replace(/</g, '&lt;').replace(/>/g, '&gt;')}</pre>
    </div>
  `;
}

// 服务控制
window.toggleService = async (name) => {
  const running = await api.checkProcess(name);
  if (running) {
    await api.exec(`pkill -f "${name}"`);
  } else {
    await api.exec(`nohup ${name} > /dev/null 2>&1 &`);
  }
  setTimeout(() => loadPage('dashboard'), 1000);
};

window.startAll = async () => {
  await api.exec('hermes gateway &');
  setTimeout(() => loadPage('dashboard'), 2000);
};

window.stopAll = async () => {
  await api.exec('pkill -f "hermes gateway"');
  await api.exec('pkill -f "phone_auto_connect"');
  await api.exec('pkill -f "droidpilot"');
  setTimeout(() => loadPage('dashboard'), 1000);
};

window.refresh = () => loadPage('dashboard');

// 初始化
loadPage('dashboard');
