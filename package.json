{
  "name": "chenyi-panel",
  "version": "1.0.0",
  "description": "晨翼Agent控制面板 - Electron桌面客户端",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "keywords": [
    "chenyi",
    "agent",
    "electron"
  ],
  "author": {
    "name": "Fangpeng",
    "email": "245659216@qq.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fangpeng2025/chenyi-panel.git"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "eventemitter3": "^5.0.4",
    "node-machine-id": "^1.1.12",
    "sortablejs": "^1.15.7",
    "uuid": "^14.0.0",
    "ws": "^8.20.0"
  },
  "build": {
    "appId": "com.chenyi.panel",
    "productName": "晨翼控制面板",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "src/native/*.node"
    ],
    "files": [
      "**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md}"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png"
    }
  }
}
